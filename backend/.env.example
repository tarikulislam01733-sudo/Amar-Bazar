PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/safekroy
REDIS_URL=redis://localhost:6379

# JWT Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Security
SERVER_PEPPER=your_secure_server_pepper_for_nid_hashing

# AWS S3 (for image uploads)
AWS_S3_BUCKET=your_s3_bucket_name
AWS_S3_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# SMS Gateway
SMS_API_KEY=your_sms_gateway_api_key
SMS_API_URL=https://api.sms-provider.com/v1/send

# Porichoy NID Verification API
PORICHOY_API_KEY=your_porichoy_api_key
PORICHOY_API_URL=https://api.porichoy.com/v1/verify
